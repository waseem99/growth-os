# Public URLs are optional locally and validated when set.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://growthos:growthos@localhost:5432/growthos

# Demo seed protection. Leave unset/0 for production. Set to 1 only for an intentionally disposable remote preview/demo database.
ALLOW_DEMO_SEED=0

# Auth.js / Google OAuth. Replace these placeholders outside local/CI environments.
AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Vercel Blob is used for direct browser-to-storage campaign asset uploads.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Server-to-server downstream subscription/conversion ingestion.
CONVERSION_INGEST_SECRET=replace-with-a-long-random-bearer-secret

# Optional safe operational alert destination. Structured logs always go to stdout/stderr.
# The application sends only service/event/error/correlation metadata, never request payloads or secrets.
ERROR_ALERT_WEBHOOK_URL=

# Optional AI authoring. If omitted, all manual workflows and deterministic quality checks continue to work.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_MODEL=replace-with-an-available-structured-output-model
# Optional for compatible gateways; defaults to the OpenAI API base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
