# Public URLs are optional locally and validated when set.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://growthos:growthos@localhost:5432/growthos

# Auth.js / Google OAuth. Replace these placeholders outside local/CI environments.
AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
