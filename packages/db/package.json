{
  "name": "@growth-os/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.ts",
    "seed": "node scripts/assert-seed-safe.mjs && tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:schema": "tsx scripts/verify-schema.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4"
  }
}
